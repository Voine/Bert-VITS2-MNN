{
  "train": {
    "log_interval": 200,
    "eval_interval": 2000,
    "seed": 42,
    "epochs": 300,
    "learning_rate": 0.0002,
    "betas": [
      0.8,
      0.99
    ],
    "eps": 1e-09,
    "batch_size": 64,
    "bf16_run": true,
    "lr_decay": 0.99995,
    "segment_size": 8448,
    "init_lr_ratio": 1,
    "warmup_epochs": 0,
    "c_mel": 45,
    "c_kl": 1.0,
    "c_commit": 100,
    "skip_optimizer": true,
    "freeze_ZH_bert": false,
    "freeze_JP_bert": false,
    "freeze_EN_bert": false,
    "freeze_emo": false,
    "warmup_steps": 1000,
    "use_cos_scheduler": true,
    "use_wav_lm": true,
    "use_just_zh_encoder": false,
    "force_interation0": true
  },
  "data": {
    "training_files": "Data/filelists/train.list",
    "validation_files": "Data/filelists/val.list",
    "max_wav_value": 32768.0,
    "sampling_rate": 22050,
    "filter_length": 1024,
    "hop_length": 256,
    "win_length": 1024,
    "n_mel_channels": 100,
    "mel_fmin": 0.0,
    "mel_fmax": null,
    "add_blank": true,
    "n_speakers": 1602,
    "cleaned_text": true,
    "spk2id": {}
  },
  "model": {
    "use_spk_conditioned_encoder": true,
    "use_noise_scaled_mas": true,
    "use_mel_posterior_encoder": false,
    "use_duration_discriminator": true,
    "inter_channels": 192,
    "hidden_channels": 192,
    "filter_channels": 768,
    "n_heads": 2,
    "n_layers": 6,
    "kernel_size": 3,
    "p_dropout": 0.1,
    "resblock": "1",
    "resblock_kernel_sizes": [
      3,
      5,
      7
    ],
    "resblock_dilation_sizes": [
      [
        1,
        2
      ],
      [
        2,
        6
      ],
      [
        3,
        12
      ]
    ],
    "upsample_rates": [
      8,
      8,
      4
    ],
    "upsample_initial_channel": 160,
    "upsample_kernel_sizes": [
      16,
      16,
      8
    ],
    "n_layers_q": 3,
    "use_spectral_norm": false,
    "gin_channels": 512,
    "slm": {
      "model": "microsoft/wavlm-base-plus",
      "sr": 16000,
      "hidden": 768,
      "nlayers": 13,
      "initial_channel": 64
    }
  },
  "version": "2.3"
}